# ---------------- LLM reasoning layer (optional) ----------------
# none | anthropic | openai | openai_compatible   (without a key CityOS uses its deterministic reasoner)
LLM_PROVIDER=none
LLM_MODEL=
LLM_API_KEY=
# For openai_compatible (e.g. a local model server): base URL without /v1
LLM_BASE_URL=
LLM_MIN_INTERVAL_SECONDS=30
LLM_TIMEOUT_SECONDS=40

# ---------------- Simulation ----------------
TICK_SECONDS=2              # real seconds per loop iteration
SIM_MINUTES_PER_TICK=5      # simulated minutes per iteration (1 sim-day ≈ 10 real minutes)
RANDOM_SEED=7
EVENT_RATE=1.0              # multiplier on incidents / faults
HISTORY_DAYS=14             # synthetic history used to train the models on first start

# ---------------- Priority thresholds (Severity × Probability × Impact × Urgency × 100) ----------------
PRIORITY_MEDIUM=8
PRIORITY_HIGH=20
PRIORITY_CRITICAL=40

# ---------------- Detection thresholds (adapted at runtime) ----------------
Z_THRESHOLD=3.0
CONGESTION_VC_THRESHOLD=0.85
OVERFLOW_HORIZON_HOURS=6
OVERFLOW_FILL=0.80
PEAK_THRESHOLD_KW=0         # 0 = derived from history
FAILURE_PROB_THRESHOLD=0.35

# ---------------- Safety / authorisation ----------------
# Keep false: emergency dispatch, signal pre-emption, precautionary closures etc. wait for a human.
AUTO_APPROVE_HIGH_IMPACT_IN_SIMULATION=false
APPROVAL_TIMEOUT_TICKS=36
VERIFICATION_TICKS=6

# ---------------- City ----------------
CITY_NAME=Patiala
CURRENCY=₹

# ---------------- Economics & carbon ASSUMPTIONS (rupees; edit to match current PSPCL tariffs and local costs) ----------------
TARIFF_OFFPEAK_PER_KWH=6.0
TARIFF_SHOULDER_PER_KWH=7.5
TARIFF_PEAK_PER_KWH=9.0
DEMAND_CHARGE_PER_KW=250      # per kW per month
FUEL_COST_PER_L=90
VALUE_OF_TIME_PER_HOUR=150
TRUCK_COST_PER_KM=40
CARBON_SHADOW_PRICE_PER_KG=2.5
GRID_KGCO2_PER_KWH=0.71       # approx. Indian grid average

# ---------------- Data connectors (optional) ----------------
# DATASET_CONNECTORS=traffic=csv:data/my_counts.csv;weather=rest:https://example.org/api/weather
DATASET_CONNECTORS=
WEATHER_SOURCE=synthetic
WEATHER_LAT=30.34
WEATHER_LON=76.39
DB_PATH=
